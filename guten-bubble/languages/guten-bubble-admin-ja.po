#: guten-bubble.php:183
msgid "Settings"
msgstr "設定"

#: options-page.php:35
msgid "Guten-bubble settings"
msgstr "Guten-Bubbleの設定"

#: options-page.php:39
msgid "NOTICE: To use the Guten-bubble plugin, required WordPress 5.0 or later."
msgstr "重要: Guten-bubbleプラグインを利用するには、WordPress 5.0以降が必要です。"

#: options-page.php:52
msgid "Import character icon image from media library"
msgstr "メディアライブラリからキャラアイコン画像をインポート"

#: options-page.php:67
msgid "Select character icon image"
msgstr "キャラアイコンを選択"

#: options-page.php:71
msgid "Choose Image"
msgstr "画像を選択"

#: options-page.php:72
msgid "Select from media library"
msgstr "メディアライブラリから選択"

#: options-page.php:83
msgid "Import"
msgstr "インポート"

#: options-page.php:87
msgid "Remarks"
msgstr "備考"

#: options-page.php:89
msgid "Select the image in the WordPress media library and import it into the image folder of Guten-bubble."
msgstr "WordPressのメディアライブラリから画像を選択し、Guten-bubbleの画像フォルダにインポートします。"

#: options-page.php:90
msgid "The recommended image size is 120px x 120px or more."
msgstr "画像のサイズは120px × 120px以上を推奨します。"

#: options-page.php:91
msgid "Imported icon images are not deleted even if they are deleted from the media library."
msgstr "メディアファイルからアイコン画像を削除しても、インポート済みのものは削除されず残ります。"

#: options-page.php:95
msgid "Attention"
msgstr "注意"

#: options-page.php:97
msgid "If there is an image file of the same name in the import destination, it will be overwritten."
msgstr "インポート済みのものと同じファイル名の画像をインポートした場合、上書きされます。"

#: options-page.php:111
msgid "Default character icon list"
msgstr "デフォルトのキャラアイコン一覧"

#: options-page.php:120
msgid "Imported character icon list"
msgstr "インポート済みのキャラアイコンの一覧"

#: options-page.php:171
#, php-format
msgid "ERROR: The selected image URL is invalid. ('%s')"
msgstr "エラー: 選択された画像のURLが無効です。(‘%s’)"

#: options-page.php:177
#, php-format
msgid "ERROR: '%s' does not exist or the file path is invalid."
msgstr "エラー: ‘%s’ が存在しないか、ファイルパスが無効です。"

#: options-page.php:183
#, php-format
msgid "ERROR: Failed to import '%s'."
msgstr "エラー: ‘%s’ のインポートに失敗しました。"

#: options-page.php:188
#, php-format
msgid "Info: '%s' is imported."
msgstr "情報: ‘%s’ をインポートしました。"

